# Beefree MCP key — used to authenticate against api.getbee.io and access the Beefree SDK MCP
BEE_API_KEY=your_mcp_key_here

# Beefree API base URL (no trailing slash)
BEE_API_BASE=https://api.getbee.io

# ── OPTIONAL: Beefree SDK Editor (for the in-editor pages: /builder and /integration) ──────
# Get these from https://developers.beefree.io — your application's credentials
BEE_CLIENT_ID=your_client_id_here
BEE_CLIENT_SECRET=your_client_secret_here

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | google
# A default model is automatically selected per provider:
#   anthropic → claude-sonnet-5-5
#   openai    → gpt-6.1-sol
#   google    → gemini-3.8-flash
AI_PROVIDER=anthropic
# Optional explicit override (takes precedence over AI_PROVIDER's default):
# LLM_MODEL=anthropic:claude-sonnet-5-5

# ── Provider API keys ─────────────────────────────────────────────────────────
# Uncomment and fill in the key for your chosen provider.
# PydanticAI reads these standard env vars automatically.

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI
# OPENAI_API_KEY=your_openai_key_here

# Google (Gemini via Google AI Studio)
# GOOGLE_API_KEY=your_google_ai_key_here
# Alternatively, use GEMINI_API_KEY (no need to set both):
# GEMINI_API_KEY=your_google_ai_key_here
